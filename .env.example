# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================================
# SEGURIDAD Y AUTENTICACION PARA PRODUCCION PUBLICA
# ==========================================================
# Clave HMAC para firmar tokens de sesion (minimo 32 caracteres aleatorios).
# Si se omite, el servidor genera y persiste una clave aleatoria en data/.auth_secret.
AUTH_SECRET=""

# Clave interna compartida para webhooks locales del dialplan Asterisk -> Node.js.
INTERNAL_WEBHOOK_KEY=""

# Contrasenas iniciales de bootstrap (solo si data/users.json aun no existe).
# Cambialas inmediatamente despues del primer despliegue.
ADMIN_DEFAULT_PASSWORD=""
TELEVOX_DEFAULT_PASSWORD=""

# ==========================================================
# CONEXION ASTERISK AMI & PUENTE REMOTO
# ==========================================================
ASTERISK_HOST="127.0.0.1"
AMI_HOST="127.0.0.1"
AMI_PORT="5038"
AMI_USER="sammy"
AMI_SECRET=""
AMI_ADMIN_SECRET=""

# Opcional: URL del VPS Asterisk si el panel corre en otro servidor + Token Bearer admin
ASTERISK_REMOTE_HTTP=""
REMOTE_ASTERISK_TOKEN=""
